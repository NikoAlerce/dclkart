        });
      }
    }
    engine.removeEntity(spawnProbeEnt);
  });
  let spawnAttempts = 0;
  let timeSinceLastSpawnAttempt = 0;
  engine.addSystem((dt) => {
    if (spawnAttempts >= 5)
      return;
    if (!Transform2.has(engine.PlayerEntity))
      return;
    timeSinceLastSpawnAttempt += dt;
    const pos = Transform2.get(engine.PlayerEntity).position;
    const dx = pos.x - SPAWN_POSITION.x;
    const dz = pos.z - SPAWN_POSITION.z;
    if (Math.sqrt(dx * dx + dz * dz) < 5) {
      spawnAttempts = 5;
      return;
    }
    if (timeSinceLastSpawnAttempt >= 1 || spawnAttempts === 0) {
