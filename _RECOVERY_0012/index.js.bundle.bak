var MagicWindParticle = engine.defineComponent("MagicWindParticle", {
  speed: Schemas.Vector3,
  // velocidad de deriva (viento + variación)
  phase: Schemas.Vector3,
  // desfase para la oscilación en X, Y, Z
  freq: Schemas.Vector3,
  // frecuencia de oscilación
  amp: Schemas.Vector3,
  // amplitud de oscilación
  age: Schemas.Float
  // edad de la partícula
});
var PARTICLE_POOL_SIZE = 150;
var SPAWN_RADIUS = 35;
var MAX_RADIUS = 40;
var WIND_VELOCITY = Vector33.create(1.5, 0.1, 0.7);
var COLORS = [
  { albedo: Color42.create(1, 0.85, 0.3, 0.9), emissive: Color32.create(2.5, 1.8, 0.3) },
  // Oro cálido (fuego fatuo/luciérnaga)
  { albedo: Color42.create(0.2, 0.9, 1, 0.9), emissive: Color32.create(0.3, 2, 2.5) },
  // Cian mágico (energía cósmica)
  { albedo: Color42.create(0.8, 0.3, 1, 0.9), emissive: Color32.create(2, 0.3, 2.5) },
  // Violeta/Púrpura
  { albedo: Color42.create(0.2, 1, 0.4, 0.9), emissive: Color32.create(0.3, 2.5, 0.6) }
  // Verde hada
];
function resetParticle(entity, referencePos) {
  const randomPos = Vector33.create(
    referencePos.x + (Math.random() - 0.5) * SPAWN_RADIUS * 2,
    referencePos.y + (Math.random() - 0.2) * 12 + 1.5,
    // dispersión vertical entre +1.5m y +13.5m de altura
    referencePos.z + (Math.random() - 0.5) * SPAWN_RADIUS * 2
  );
  const scaleSize = 0.05 + Math.random() * 0.12;
  const scaleVec = Vector33.create(scaleSize, scaleSize, scaleSize);
  if (Transform2.has(entity)) {
    const t = Transform2.getMutable(entity);
    t.position = randomPos;
    t.scale = scaleVec;
  } else {
    Transform2.create(entity, {
      position: randomPos,
      scale: scaleVec
    });
  }
  const colorScheme = COLORS[Math.floor(Math.random() * COLORS.length)];
  Material3.setPbrMaterial(entity, {
    albedoColor: colorScheme.albedo,
    emissiveColor: colorScheme.emissive,
    emissiveIntensity: 5 + Math.random() * 5,
    roughness: 1
  });
  const particleData = {
    speed: Vector33.create(
      WIND_VELOCITY.x + (Math.random() - 0.5) * 0.5,
      WIND_VELOCITY.y + (Math.random() - 0.5) * 0.1,
      WIND_VELOCITY.z + (Math.random() - 0.5) * 0.5
    ),
    phase: Vector33.create(Math.random() * 10, Math.random() * 10, Math.random() * 10),
    freq: Vector33.create(1 + Math.random() * 2, 0.8 + Math.random() * 1.5, 1.2 + Math.random() * 2),
    amp: Vector33.create(0.4 + Math.random() * 0.8, 0.2 + Math.random() * 0.5, 0.4 + Math.random() * 0.8),
    age: 0
  };
  if (MagicWindParticle.has(entity)) {
    const p = MagicWindParticle.getMutable(entity);
    p.speed = particleData.speed;
    p.phase = particleData.phase;
    p.freq = particleData.freq;
    p.amp = particleData.amp;
    p.age = particleData.age;
  } else {
    MagicWindParticle.create(entity, particleData);
  }
}
var initialized = false;
var particles = [];
function setupWindParticles() {
  if (initialized)
    return;
  initialized = true;
  for (let i = 0; i < PARTICLE_POOL_SIZE; i++) {
    const entity = engine.addEntity();
    MeshRenderer3.setSphere(entity);
    particles.push(entity);
  }
  engine.addSystem((dt) => {
    if (!Transform2.has(engine.PlayerEntity))
      return;
    const playerTransform = Transform2.get(engine.PlayerEntity);
    const playerPos = playerTransform.position;
    for (const entity of particles) {
      if (!MagicWindParticle.has(entity)) {
        resetParticle(entity, playerPos);
        continue;
      }
      const transform = Transform2.getMutable(entity);
      const particle = MagicWindParticle.getMutable(entity);
      particle.age += dt;
      const windStep = Vector33.scale(particle.speed, dt);
      transform.position = Vector33.add(transform.position, windStep);
      const time = particle.age;
      const swayX = Math.sin(time * particle.freq.x + particle.phase.x) * particle.amp.x * dt;
      const swayY = Math.cos(time * particle.freq.y + particle.phase.y) * particle.amp.y * dt;
      const swayZ = Math.sin(time * particle.freq.z + particle.phase.z) * particle.amp.z * dt;
      transform.position.x += swayX;
      transform.position.y += swayY;
      transform.position.z += swayZ;
      const dist = Vector33.distance(transform.position, playerPos);
      if (dist > MAX_RADIUS) {
        resetParticle(entity, playerPos);
      }
    }
  });
}

