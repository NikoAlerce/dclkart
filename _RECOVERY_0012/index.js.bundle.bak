  engine.addSystem(kartMovementSystem);
  engine.addSystem(turboParticleSystem);
  let lastTeleportTime = 0;
  engine.addSystem(() => {
    if (RaceState.isOccupied)
      return;
    if (RaceState.ridingMonster)
      return;
    if (!Transform2.has(engine.PlayerEntity))
      return;
    const playerTransform = Transform2.get(engine.PlayerEntity);
    if (playerTransform.position.y < 2) {
      const now = Date.now();
      if (now - lastTeleportTime > 3e3) {
        lastTeleportTime = now;
        const spawnY = actualGroundY !== null ? actualGroundY + 1.5 : SPAWN_POSITION.y;
        (0, import_RestrictedActions3.movePlayerTo)({
          newRelativePosition: Vector33.create(SPAWN_POSITION.x, spawnY, SPAWN_POSITION.z),
          cameraTarget: SPAWN_CAMERA_TARGET
